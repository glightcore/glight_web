---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GLightOne Documentation | GLightCore</title>

    <style>
      @font-face {
        font-family: 'Orbitron';
        src: url('/fonts/Orbitron.ttf') format('truetype');
        font-weight: 100 900;
        font-display: swap;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
        background: #000;
      }

      body {
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        font-family: 'Orbitron', system-ui, sans-serif;
        color: #ffffff;
        background:
          radial-gradient(circle at 50% 18%, rgba(120, 200, 255, 0.16) 0%, rgba(40, 120, 255, 0.08) 23%, transparent 44%),
          radial-gradient(ellipse at center, #070b14 0%, #02040a 48%, #000000 100%);
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          repeating-linear-gradient(
            90deg,
            rgba(220, 240, 255, 0.025) 0px,
            rgba(220, 240, 255, 0.025) 1px,
            transparent 1px,
            transparent 96px
          ),
          repeating-linear-gradient(
            0deg,
            rgba(220, 240, 255, 0.018) 0px,
            rgba(220, 240, 255, 0.018) 1px,
            transparent 1px,
            transparent 96px
          );
        opacity: 0.38;
      }

      .docs-page {
        position: relative;
        width: 100%;
        min-height: 100vh;
        padding: 58px 22px 70px;
      }

      .docs-shell {
        position: relative;
        max-width: 980px;
        margin: 0 auto;
        z-index: 2;
      }

      .reactor-glow {
        position: fixed;
        top: 24%;
        left: 50%;
        width: min(620px, 82vw);
        height: min(620px, 82vw);
        transform: translateX(-50%);
        border-radius: 50%;
        pointer-events: none;
        background: radial-gradient(
          circle,
          rgba(255,255,255,0.38) 0%,
          rgba(160,225,255,0.24) 12%,
          rgba(120,200,255,0.20) 24%,
          rgba(40,120,255,0.16) 40%,
          rgba(0,70,180,0.09) 56%,
          rgba(0,0,0,0) 74%
        );
        box-shadow:
          0 0 140px rgba(80,160,255,0.34),
          0 0 320px rgba(90,220,230,0.18),
          0 0 620px rgba(80,255,150,0.08);
        opacity: 0.92;
        z-index: 0;
      }

      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 42px;
      }

      .brand {
        font-size: clamp(15px, 2.4vw, 22px);
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(235, 248, 255, 0.92);
        text-shadow:
          0 0 6px rgba(180,220,255,0.55),
          0 0 28px rgba(120,180,255,0.38);
      }

      .explore {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 17px;
        border: 1px solid rgba(142, 230, 255, 0.28);
        border-radius: 999px;
        color: rgba(235, 248, 255, 0.9);
        background: rgba(255,255,255,0.035);
        text-decoration: none;
        font-size: 12px;
        letter-spacing: 0.12em;
        transition: 0.18s ease;
      }

      .explore:hover {
        color: #061014;
        background: rgba(142, 230, 255, 0.95);
        box-shadow:
          0 0 18px rgba(142,230,255,0.32),
          0 0 48px rgba(120,180,255,0.18);
      }

      .panel {
        position: relative;
        min-height: clamp(640px, 72vh, 820px);
        border: 1px solid rgba(142, 230, 255, 0.23);
        border-radius: 24px;
        padding: clamp(24px, 4vw, 36px) clamp(22px, 4vw, 34px) clamp(42px, 7vh, 82px);
        background:
          linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.016)),
          radial-gradient(circle at top right, rgba(120, 220, 255, 0.13), transparent 42%),
          rgba(2, 4, 10, 0.72);
        box-shadow:
          0 22px 70px rgba(0,0,0,0.42),
          0 0 80px rgba(80,160,255,0.08),
          0 0 140px rgba(90,220,230,0.05),
          inset 0 0 0 1px rgba(255,255,255,0.035);
        backdrop-filter: blur(8px);
      }

      .system-layer {
        margin-bottom: 16px;
        font-size: 12px;
        letter-spacing: 0.24em;
        color: rgba(220,240,255,0.82);
        text-transform: uppercase;
        text-shadow:
          0 0 6px rgba(180,220,255,0.45),
          0 0 20px rgba(120,180,255,0.28);
      }

      .flash-line {
        position: relative;
        width: min(460px, 86vw);
        height: 1px;
        margin: 2px 0 28px;
        border-radius: 999px;
        background: linear-gradient(
          90deg,
          transparent 0%,
          rgba(255,255,255,0.00) 10%,
          rgba(255,255,255,0.38) 24%,
          rgba(245,250,255,0.92) 43%,
          rgba(255,255,255,1.00) 50%,
          rgba(245,250,255,0.86) 57%,
          rgba(150,220,255,0.30) 72%,
          transparent 100%
        );
        box-shadow:
          0 0 5px rgba(255,255,255,0.85),
          0 0 14px rgba(220,245,255,0.48),
          0 0 34px rgba(120,210,255,0.20);
      }

      .flash-line::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 5px;
        height: 5px;
        transform: translate(-50%, -50%);
        border-radius: 999px;
        background: radial-gradient(
          circle,
          rgba(255,255,255,1) 0%,
          rgba(255,255,255,0.96) 22%,
          rgba(220,245,255,0.70) 44%,
          rgba(120,210,255,0.20) 68%,
          transparent 78%
        );
        box-shadow:
          0 0 8px rgba(255,255,255,0.95),
          0 0 18px rgba(220,245,255,0.55),
          0 0 40px rgba(120,210,255,0.22);
      }

      .flash-line::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1px;
        height: 16px;
        transform: translate(-50%, -50%);
        border-radius: 999px;
        background: linear-gradient(
          180deg,
          transparent 0%,
          rgba(255,255,255,0.45) 28%,
          rgba(255,255,255,0.95) 50%,
          rgba(255,255,255,0.45) 72%,
          transparent 100%
        );
        box-shadow:
          0 0 5px rgba(255,255,255,0.72),
          0 0 14px rgba(220,245,255,0.35);
      }

      .lang {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin: 0 0 28px;
      }

      button {
        border: 1px solid rgba(142, 230, 255, 0.25);
        background: rgba(255,255,255,0.035);
        color: rgba(245, 250, 255, 0.88);
        padding: 10px 15px;
        border-radius: 999px;
        cursor: pointer;
        font-family: 'Orbitron', system-ui, sans-serif;
        font-size: 12px;
        letter-spacing: 0.1em;
        transition: 0.18s ease;
      }

      button:hover {
        border-color: rgba(142, 230, 255, 0.85);
        box-shadow: 0 0 20px rgba(142,230,255,0.15);
      }

      button.active {
        background: rgba(142, 230, 255, 0.95);
        color: #061014;
        border-color: rgba(142, 230, 255, 1);
        box-shadow:
          0 0 18px rgba(142,230,255,0.32),
          0 0 44px rgba(120,180,255,0.14);
      }

      h1 {
        margin: 0 0 14px;
        font-size: clamp(30px, 6vw, 58px);
        line-height: 1.05;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #d8dde3;
        text-shadow:
          0 -1px 0 rgba(210,235,255,0.55),
          0 -2px 0 rgba(255,255,255,0.18),
          0 1px 0 rgba(0,0,0,0.95),
          0 8px 24px rgba(0,0,0,0.78),
          0 0 28px rgba(120,180,255,0.22);
      }

      h2 {
        margin: 34px 0 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        font-size: 15px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(235, 248, 255, 0.92);
      }

      p {
        margin: 0 0 12px;
        color: rgba(220, 228, 238, 0.76);
        line-height: 1.65;
        font-size: 15px;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
      }

      .card {
        display: block;
        min-height: 118px;
        padding: 18px;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        background:
          linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.014)),
          rgba(7, 11, 20, 0.84);
        color: #fff;
        text-decoration: none;
        transition: 0.18s ease;
      }

      .card:hover {
        border-color: rgba(142, 230, 255, 0.82);
        transform: translateY(-2px);
        box-shadow:
          0 14px 36px rgba(0,0,0,0.32),
          0 0 26px rgba(142,230,255,0.10);
      }

      .card strong {
        display: block;
        margin-bottom: 9px;
        font-size: 14px;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .card span {
        color: rgba(220, 228, 238, 0.72);
        font-size: 14px;
        line-height: 1.5;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .note {
        margin-top: 26px;
        padding: 17px 18px;
        border-left: 4px solid rgba(142, 230, 255, 0.92);
        border-radius: 12px;
        background: rgba(255,255,255,0.04);
      }

      .note p {
        margin: 0;
      }

      footer {
        margin-top: 34px;
        padding: 18px 2px 0;
        border-top: 1px solid rgba(255,255,255,0.08);
        color: rgba(220, 228, 238, 0.66);
        font-size: 13px;
        line-height: 1.8;
      }

      footer a {
        color: rgba(142, 230, 255, 0.95);
      }

      [data-lang-content] {
        display: none;
      }

      [data-lang-content].active {
        display: block;
      }

      @media (max-width: 600px) {
        .docs-page {
          padding: 38px 16px 54px;
        }

        .topbar {
          margin-bottom: 30px;
        }

        .brand {
          font-size: 14px;
          letter-spacing: 0.12em;
        }

        .explore {
          width: 100%;
        }

        .panel {
          min-height: auto;
          border-radius: 20px;
          padding-bottom: 30px;
        }

        h1 {
          font-size: clamp(28px, 10vw, 42px);
          letter-spacing: 0.05em;
        }

        .card {
          min-height: auto;
        }
      }
    </style>
  </head>

  <body>
    <div class="docs-page">
      <div class="reactor-glow"></div>

      <main class="docs-shell">
        <div class="topbar">
          <div class="brand">GLight / GLightCoreAura</div>
          <a class="explore" href="https://glightcore.com" target="_blank" rel="noopener noreferrer">
            Explore GLightCore.com
          </a>
        </div>

        <section class="panel">
          <div class="system-layer">SYSTEM DOCUMENTATION LAYER</div>
          <div class="flash-line"></div>

          <div class="lang">
            <button data-lang-btn="en" class="active">English</button>
            <button data-lang-btn="es">Español</button>
            <button data-lang-btn="ja">日本語</button>
          </div>

          <section data-lang-content="en" class="active">
            <h1>GLightOne Documentation</h1>
            <p>
              Official technical access node for GLightOne Base.
              Manuals, wiring reference and connection pad information are available below.
            </p>

            <h2>GLightOne Base Manual</h2>
            <div class="grid">
              <a class="card" href="/docs/glightone/manual-en.pdf">
                <strong>English</strong>
                <span>GLightOne Base Technical Manual v1.0</span>
              </a>
              <a class="card" href="/docs/glightone/manual-es.pdf">
                <strong>Español</strong>
                <span>Manual técnico GLightOne Base v1.0</span>
              </a>
              <a class="card" href="/docs/glightone/manual-ja.pdf">
                <strong>日本語</strong>
                <span>GLightOne Base 技術マニュアル v1.0</span>
              </a>
            </div>

            <h2>Pinout / Wiring Reference</h2>
            <div class="grid">
              <a class="card" href="/docs/glightone/pinout.png">
                <strong>GLightOne Base Pinout Map</strong>
                <span>Connection pads and wiring reference image</span>
              </a>
            </div>

            <div class="note">
              <p>
                LED outputs are low-side / GND control. They do not provide +12V.
                MODE requires a momentary push button to GND.
                DRL_SW uses an ON/OFF switch to +12V.
              </p>
            </div>
          </section>

          <section data-lang-content="es">
            <h1>Documentación GLightOne</h1>
            <p>
              Nodo oficial de acceso técnico para GLightOne Base.
              Manuales, referencia de cableado y mapa de pads de conexión disponibles abajo.
            </p>

            <h2>Manual GLightOne Base</h2>
            <div class="grid">
              <a class="card" href="/docs/glightone/manual-es.pdf">
                <strong>Español</strong>
                <span>Manual técnico GLightOne Base v1.0</span>
              </a>
              <a class="card" href="/docs/glightone/manual-en.pdf">
                <strong>English</strong>
                <span>GLightOne Base Technical Manual v1.0</span>
              </a>
              <a class="card" href="/docs/glightone/manual-ja.pdf">
                <strong>日本語</strong>
                <span>GLightOne Base 技術マニュアル v1.0</span>
              </a>
            </div>

            <h2>Pinout / Referencia de cableado</h2>
            <div class="grid">
              <a class="card" href="/docs/glightone/pinout.png">
                <strong>Mapa de pinout GLightOne Base</strong>
                <span>Imagen de referencia de pads de conexión y cableado</span>
              </a>
            </div>

            <div class="note">
              <p>
                Las salidas LED trabajan por control negativo / GND. No entregan +12V.
                MODE requiere pulsador momentáneo a GND.
                DRL_SW utiliza interruptor ON/OFF hacia +12V.
              </p>
            </div>
          </section>

          <section data-lang-content="ja">
            <h1>GLightOne ドキュメント</h1>
            <p>
              GLightOne Base の公式技術アクセスノードです。
              マニュアル、配線リファレンス、接続パッド情報を以下から確認できます。
            </p>

            <h2>GLightOne Base マニュアル</h2>
            <div class="grid">
              <a class="card" href="/docs/glightone/manual-ja.pdf">
                <strong>日本語</strong>
                <span>GLightOne Base 技術マニュアル v1.0</span>
              </a>
              <a class="card" href="/docs/glightone/manual-en.pdf">
                <strong>English</strong>
                <span>GLightOne Base Technical Manual v1.0</span>
              </a>
              <a class="card" href="/docs/glightone/manual-es.pdf">
                <strong>Español</strong>
                <span>Manual técnico GLightOne Base v1.0</span>
              </a>
            </div>

            <h2>ピンアウト / 配線リファレンス</h2>
            <div class="grid">
              <a class="card" href="/docs/glightone/pinout.png">
                <strong>GLightOne Base ピンアウトマップ</strong>
                <span>接続パッドおよび配線リファレンス画像</span>
              </a>
            </div>

            <div class="note">
              <p>
                LED出力はローサイド / GND制御です。+12Vを出力しません。
                MODEにはGNDへ接続するモーメンタリープッシュボタンを使用します。
                DRL_SWには+12Vへ接続するON/OFFスイッチを使用します。
              </p>
            </div>
          </section>
        </section>

        <footer>
          GLight / GLightCoreAura Technology Platform · Tokyo — Japan<br />
          Support:
          <a href="mailto:glight@glightcore.com">glight@glightcore.com</a>
          &nbsp;|&nbsp;
          <a href="https://glightcore.com" target="_blank" rel="noopener noreferrer">Explore GLightCore.com</a>
        </footer>
      </main>
    </div>

    <script>
      const buttons = document.querySelectorAll("[data-lang-btn]");
      const sections = document.querySelectorAll("[data-lang-content]");

      function setLang(lang) {
        buttons.forEach((btn) => btn.classList.toggle("active", btn.dataset.langBtn === lang));
        sections.forEach((section) => section.classList.toggle("active", section.dataset.langContent === lang));
        localStorage.setItem("glightone-doc-lang", lang);
      }

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => setLang(btn.dataset.langBtn));
      });

      const saved = localStorage.getItem("glightone-doc-lang");
      if (saved && ["en", "es", "ja"].includes(saved)) setLang(saved);
    </script>
  </body>
</html>
