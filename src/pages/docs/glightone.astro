---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Official GLightOne Base technical manuals, pinout and wiring documentation."
    />
    <title>GLightOne Documentation | GLightCore</title>

    <style is:inline>
      @font-face {
        font-family: 'Orbitron';
        src: url('/fonts/Orbitron.ttf') format('truetype');
        font-weight: 100 900;
        font-display: swap;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
        background: #000;
      }

      body {
        margin: 0;
        min-height: 100vh;
        overflow-x: hidden;
        font-family: 'Orbitron', system-ui, sans-serif;
        color: #ffffff;
        background:
          radial-gradient(circle at 50% 18%, rgba(120, 200, 255, 0.16) 0%, rgba(40, 120, 255, 0.08) 23%, transparent 44%),
          radial-gradient(ellipse at center, #070b14 0%, #02040a 48%, #000000 100%);
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          repeating-linear-gradient(
            90deg,
            rgba(220, 240, 255, 0.025) 0px,
            rgba(220, 240, 255, 0.025) 1px,
            transparent 1px,
            transparent 96px
          ),
          repeating-linear-gradient(
            0deg,
            rgba(220, 240, 255, 0.018) 0px,
            rgba(220, 240, 255, 0.018) 1px,
            transparent 1px,
            transparent 96px
          );
        opacity: 0.38;
      }

      .docs-page {
        position: relative;
        width: 100%;
        min-height: 100vh;
        padding: 58px 22px 70px;
      }

      .docs-shell {
        position: relative;
        max-width: 980px;
        margin: 0 auto;
        z-index: 2;
      }

      .reactor-glow {
        position: fixed;
        top: 24%;
        left: 50%;
        width: min(620px, 82vw);
        height: min(620px, 82vw);
        transform: translateX(-50%);
        border-radius: 50%;
        pointer-events: none;
        background: radial-gradient(
          circle,
          rgba(255,255,255,0.38) 0%,
          rgba(160,225,255,0.24) 12%,
          rgba(120,200,255,0.20) 24%,
          rgba(40,120,255,0.16) 40%,
          rgba(0,70,180,0.09) 56%,
          rgba(0,0,0,0) 74%
        );
        box-shadow:
          0 0 140px rgba(80,160,255,0.34),
          0 0 320px rgba(90,220,230,0.18),
          0 0 620px rgba(80,255,150,0.08);
        opacity: 0.92;
        z-index: 0;
      }

      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 42px;
      }

      .brand {
        font-size: clamp(15px, 2.4vw, 22px);
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(235, 248, 255, 0.92);
        text-shadow:
          0 0 6px rgba(180,220,255,0.55),
          0 0 28px rgba(120,180,255,0.38);
      }

      .explore {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 17px;
        border: 1px solid rgba(142, 230, 255, 0.28);
        border-radius: 999px;
        color: rgba(235, 248, 255, 0.9);
        background: rgba(255,255,255,0.035);
        text-decoration: none;
        font-size: 12px;
        letter-spacing: 0.12em;
        transition: 0.18s ease;
      }

      .explore:hover {
        color: #061014;
        background: rgba(142, 230, 255, 0.95);
        box-shadow:
          0 0 18px rgba(142,230,255,0.32),
          0 0 48px rgba(120,180,255,0.18);
      }

      .panel {
        position: relative;
        min-height: clamp(640px, 72vh, 820px);
        border: 1px solid rgba(142, 230, 255, 0.23);
        border-radius: 24px;
        padding: clamp(24px, 4vw, 36px) clamp(22px, 4vw, 34px) clamp(42px, 7vh, 82px);
        background:
          linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.016)),
          radial-gradient(circle at top right, rgba(120, 220, 255, 0.13), transparent 42%),
          rgba(2, 4, 10, 0.72);
        box-shadow:
          0 22px 70px rgba(0,0,0,0.42),
          0 0 80px rgba(80,160,255,0.08),
          0 0 140px rgba(90,220,230,0.05),
          inset 0 0 0 1px rgba(255,255,255,0.035);
        backdrop-filter: blur(8px);
      }

      .system-layer {
        margin-bottom: 16px;
        font-size: 12px;
        letter-spacing: 0.24em;
        color: rgba(220,240,255,0.82);
        text-transform: uppercase;
        text-shadow:
          0 0 6px rgba(180,220,255,0.45),
          0 0 20px rgba(120,180,255,0.28);
      }

      .flash-line {
        position: relative;
        width: min(460px, 86vw);
        height: 1px;
        margin: 2px 0 28px;
        border-radius: 999px;
        background: linear-gradient(
          90deg,
          transparent 0%,
          rgba(255,255,255,0.00) 10%,
          rgba(255,255,255,0.38) 24%,
          rgba(245,250,255,0.92) 43%,
          rgba(255,255,255,1.00) 50%,
          rgba(245,250,255,0.86) 57%,
          rgba(150,220,255,0.30) 72%,
          transparent 100%
        );
        box-shadow:
          0 0 5px rgba(255,255,255,0.85),
          0 0 14px rgba(220,245,255,0.48),
          0 0 34px rgba(120,210,255,0.20);
      }

      .flash-line::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 5px;
        height: 5px;
        transform: translate(-50%, -50%);
        border-radius: 999px;
        background: radial-gradient(
          circle,
          rgba(255,255,255,1) 0%,
          rgba(255,255,255,0.96) 22%,
          rgba(220,245,255,0.70) 44%,
          rgba(120,210,255,0.20) 68%,
          transparent 78%
        );
        box-shadow:
          0 0 8px rgba(255,255,255,0.95),
          0 0 18px rgba(220,245,255,0.55),
          0 0 40px rgba(120,210,255,0.22);
      }

      .flash-line::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1px;
        height: 16px;
        transform: translate(-50%, -50%);
        border-radius: 999px;
        background: linear-gradient(
          180deg,
          transparent 0%,
          rgba(255,255,255,0.45) 28%,
          rgba(255,255,255,0.95) 50%,
          rgba(255,255,255,0.45) 72%,
          transparent 100%
        );
        box-shadow:
          0 0 5px rgba(255,255,255,0.72),
          0 0 14px rgba(220,245,255,0.35);
      }

      .lang {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin: 0 0 28px;
      }

      .lang button {
        flex: 1 1 128px;
        max-width: 190px;
      }

      button {
        border: 1px solid rgba(142, 230, 255, 0.25);
        background: rgba(255,255,255,0.035);
        color: rgba(245, 250, 255, 0.88);
        padding: 10px 15px;
        border-radius: 999px;
        cursor: pointer;
        font-family: 'Orbitron', system-ui, sans-serif;
        font-size: 12px;
        letter-spacing: 0.1em;
        transition: 0.18s ease;
      }

      button:hover {
        border-color: rgba(142, 230, 255, 0.85);
        box-shadow: 0 0 20px rgba(142,230,255,0.15);
      }

      button.active {
        background: rgba(142, 230, 255, 0.95);
        color: #061014;
        border-color: rgba(142, 230, 255, 1);
        box-shadow:
          0 0 18px rgba(142,230,255,0.32),
          0 0 44px rgba(120,180,255,0.14);
      }

      h1 {
        margin: 0 0 14px;
        font-size: clamp(30px, 6vw, 58px);
        line-height: 1.05;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #d8dde3;
        text-shadow:
          0 -1px 0 rgba(210,235,255,0.55),
          0 -2px 0 rgba(255,255,255,0.18),
          0 1px 0 rgba(0,0,0,0.95),
          0 8px 24px rgba(0,0,0,0.78),
          0 0 28px rgba(120,180,255,0.22);
      }

      h2 {
        margin: 34px 0 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        font-size: 15px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(235, 248, 255, 0.92);
      }

      p {
        margin: 0 0 12px;
        color: rgba(220, 228, 238, 0.76);
        line-height: 1.65;
        font-size: 15px;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
      }

      .card {
        display: block;
        min-height: 118px;
        padding: 18px;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        background:
          linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.014)),
          rgba(7, 11, 20, 0.84);
        color: #fff;
        text-decoration: none;
        transition: 0.18s ease;
      }

      .card:hover {
        border-color: rgba(142, 230, 255, 0.82);
        transform: translateY(-2px);
        box-shadow:
          0 14px 36px rgba(0,0,0,0.32),
          0 0 26px rgba(142,230,255,0.10);
      }

      .card.featured {
        border-color: rgba(142, 230, 255, 0.52);
        box-shadow:
          inset 0 0 0 1px rgba(142,230,255,0.07),
          0 0 26px rgba(142,230,255,0.07);
      }

      .card strong {
        display: block;
        margin-bottom: 9px;
        font-size: 14px;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .card span {
        color: rgba(220, 228, 238, 0.72);
        font-size: 14px;
        line-height: 1.5;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      .note {
        margin-top: 26px;
        padding: 17px 18px;
        border-left: 4px solid rgba(142, 230, 255, 0.92);
        border-radius: 12px;
        background: rgba(255,255,255,0.04);
      }

      .note p {
        margin: 0;
      }

      .note-line {
        display: block;
      }

      .note-line + .note-line {
        margin-top: 4px;
      }

      footer {
        margin-top: 34px;
        padding: 18px 2px 0;
        border-top: 1px solid rgba(255,255,255,0.08);
        color: rgba(220, 228, 238, 0.66);
        font-size: 13px;
        line-height: 1.8;
      }

      footer a {
        color: rgba(142, 230, 255, 0.95);
      }
@media (max-width: 600px) {
        .docs-page {
          padding: 38px 16px 54px;
        }

        .topbar {
          margin-bottom: 30px;
        }

        .brand {
          font-size: 14px;
          letter-spacing: 0.12em;
        }

        .explore {
          width: 100%;
        }

        .panel {
          min-height: auto;
          border-radius: 20px;
          padding-bottom: 30px;
        }

        h1 {
          font-size: clamp(28px, 10vw, 42px);
          letter-spacing: 0.05em;
        }

        .card {
          min-height: auto;
        }
      }

      /* =========================================
         GLIGHTONE DOCS — MOBILE RESPONSIVE FIX
         evita overflow del título y centra destello
      ========================================= */
      @media (max-width: 430px) {
        html,
        body {
          max-width: 100%;
          overflow-x: hidden;
        }

        .docs-page {
          width: 100%;
          padding-left: 14px;
          padding-right: 14px;
        }

        .docs-shell {
          width: 100%;
          max-width: 100%;
          overflow-x: hidden;
        }

        .topbar {
          gap: 14px;
        }

        .brand {
          width: 100%;
          font-size: 13px;
          line-height: 1.35;
          letter-spacing: 0.11em;
        }

        .explore {
          width: 100%;
          max-width: 100%;
          text-align: center;
        }

        .panel {
          width: 100%;
          max-width: 100%;
          overflow: hidden;
          padding-left: 18px;
          padding-right: 18px;
        }

        .system-layer {
          font-size: 11px;
          line-height: 1.45;
          letter-spacing: 0.18em;
        }

        .flash-line {
          width: 100%;
          max-width: 100%;
          margin-left: auto;
          margin-right: auto;
        }

        h1 {
          max-width: 100%;
          font-size: clamp(28px, 7.5vw, 36px);
          line-height: 1.08;
          letter-spacing: 0.035em;
          overflow-wrap: anywhere;
          word-break: normal;
        }

        h2 {
          font-size: 13px;
          letter-spacing: 0.14em;
          line-height: 1.45;
        }

        p {
          font-size: 14px;
          line-height: 1.62;
        }

        .lang {
          justify-content: center;
          gap: 10px;
        }

        button {
          min-width: 96px;
          padding: 10px 12px;
          font-size: 12px;
        }

        .grid {
          grid-template-columns: 1fr;
        }

        .card {
          width: 100%;
          max-width: 100%;
        }
      }

    

      .lang button {
        white-space: nowrap;
      }

      .card.recommended {
        border-color: rgba(142, 230, 255, 0.72);
        background:
          linear-gradient(180deg, rgba(142,230,255,0.085), rgba(255,255,255,0.018)),
          rgba(7, 11, 20, 0.88);
        box-shadow:
          0 0 22px rgba(142,230,255,0.10),
          inset 0 0 0 1px rgba(142,230,255,0.05);
      }

      button[data-lang-btn="ja"],
      .card[data-manual-code="ja"] {
        font-family: "Hiragino Sans", "Yu Gothic", system-ui, sans-serif;
      }

      button[data-lang-btn="ko"],
      .card[data-manual-code="ko"] {
        font-family: "Apple SD Gothic Neo", system-ui, sans-serif;
      }

      button[data-lang-btn="zh-cn"],
      .card[data-manual-code="zh-cn"] {
        font-family: "PingFang SC", "Hiragino Sans GB", system-ui, sans-serif;
      }

    </style>
  </head>

  <body>
    <div class="docs-page">
      <div class="reactor-glow"></div>

      <main class="docs-shell">
        <div class="topbar">
          <div class="brand">GLight / GLightCoreAura</div>
          <a
            id="explore-link"
            class="explore"
            href="https://glightcore.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            {translations.en.explore}
          </a>
        </div>

        <section class="panel">
          <div class="system-layer">SYSTEM DOCUMENTATION LAYER</div>
          <div class="flash-line"></div>

          <div class="lang" aria-label="Documentation language">
            {manuals.map((language) => (
              <button
                type="button"
                data-lang-btn={language.code}
                class={language.code === "en" ? "active" : ""}
                aria-pressed={language.code === "en" ? "true" : "false"}
                lang={language.htmlLang}
              >
                {language.name}
              </button>
            ))}
          </div>

          <h1 id="doc-title">{translations.en.title}</h1>
          <p id="doc-intro">{translations.en.intro}</p>

          <h2 id="manual-heading">{translations.en.manualHeading}</h2>
          <div class="grid" id="manual-grid">
            {manuals.map((manual) => (
              <a
                class={manual.code === "en" ? "card recommended" : "card"}
                data-manual-code={manual.code}
                href={manual.href}
                lang={manual.htmlLang}
              >
                <strong>{manual.name}</strong>
                <span>{manual.title}</span>
              </a>
            ))}
          </div>

          <h2 id="pinout-heading">{translations.en.pinoutHeading}</h2>
          <div class="grid">
            <a class="card" href="/docs/glightone/pinout.png">
              <strong id="pinout-title">{translations.en.pinoutTitle}</strong>
              <span id="pinout-description">{translations.en.pinoutDescription}</span>
            </a>
          </div>

          <div class="note">
            <p id="note-text">{translations.en.note}</p>
          </div>
        </section>

        <footer>
          GLight / GLightCoreAura Technology Platform · Tokyo — Japan<br />
          <span id="support-label">{translations.en.supportLabel}</span>:
          <a href="mailto:glight@glightcore.com">glight@glightcore.com</a>
          &nbsp;|&nbsp;
          <a
            id="footer-explore-link"
            href="https://glightcore.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            {translations.en.explore}
          </a>
        </footer>
      </main>
    </div>

    <script
      id="glightone-translations"
      type="application/json"
      set:html={JSON.stringify(translations)}
    ></script>

    <script is:inline>
      const translationNode = document.getElementById("glightone-translations");
      const translations = JSON.parse(translationNode?.textContent || "{}");
      const buttons = Array.from(document.querySelectorAll("[data-lang-btn]"));
      const manualCards = Array.from(document.querySelectorAll("[data-manual-code]"));
      const supported = buttons.map((button) => button.dataset.langBtn).filter(Boolean);

      const title = document.getElementById("doc-title");
      const intro = document.getElementById("doc-intro");
      const manualHeading = document.getElementById("manual-heading");
      const pinoutHeading = document.getElementById("pinout-heading");
      const pinoutTitle = document.getElementById("pinout-title");
      const pinoutDescription = document.getElementById("pinout-description");
      const noteText = document.getElementById("note-text");
      const exploreLink = document.getElementById("explore-link");
      const supportLabel = document.getElementById("support-label");
      const footerExploreLink = document.getElementById("footer-explore-link");

      function normalizeLanguage(value) {
        const language = String(value || "").toLowerCase();

        if (supported.includes(language)) return language;
        if (language.startsWith("pt")) return "pt-br";
        if (language.startsWith("zh")) return "zh-cn";

        const base = language.split("-")[0];
        return supported.includes(base) ? base : "en";
      }

      function readSavedLanguage() {
        try {
          return localStorage.getItem("glightone-doc-lang");
        } catch {
          return null;
        }
      }

      function saveLanguage(language) {
        try {
          localStorage.setItem("glightone-doc-lang", language);
        } catch {
          // Storage can be unavailable in private or restricted browser modes.
        }
      }

      function setText(element, value) {
        if (element) element.textContent = value;
      }

      function setLang(language, persist = true) {
        const lang = supported.includes(language) ? language : "en";
        const copy = translations[lang] || translations.en;

        buttons.forEach((button) => {
          const active = button.dataset.langBtn === lang;
          button.classList.toggle("active", active);
          button.setAttribute("aria-pressed", active ? "true" : "false");
        });

        manualCards.forEach((card) => {
          card.classList.toggle("recommended", card.dataset.manualCode === lang);
        });

        setText(title, copy.title);
        setText(intro, copy.intro);
        setText(manualHeading, copy.manualHeading);
        setText(pinoutHeading, copy.pinoutHeading);
        setText(pinoutTitle, copy.pinoutTitle);
        setText(pinoutDescription, copy.pinoutDescription);
        setText(noteText, copy.note);
        setText(exploreLink, copy.explore);
        setText(supportLabel, copy.supportLabel);
        setText(footerExploreLink, copy.explore);

        document.documentElement.lang = copy.htmlLang || lang;
        document.title = `${copy.title} | GLightCore`;

        if (persist) saveLanguage(lang);
      }

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          setLang(button.dataset.langBtn || "en");
        });
      });

      const requested = new URLSearchParams(window.location.search).get("lang");
      const saved = readSavedLanguage();
      const initial = requested || saved || navigator.language || "en";
      setLang(normalizeLanguage(initial), Boolean(requested || saved));
    </script>
  </body>
</html>
