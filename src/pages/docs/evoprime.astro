    <script is:inline>
      const radios = Array.from(document.querySelectorAll('input[name="docs-language"]'));
      const supported = radios.map((radio) => radio.value);

      // Download parity is intentional: no language receives a permanent
      // recommended, featured, active or aria-current state.
      document.querySelectorAll(".card[data-manual-code]").forEach((card) => {
        card.classList.remove("recommended", "active", "featured");
        card.removeAttribute("aria-current");
      });

      function normalizeLanguage(value) {
        const language = String(value || "").toLowerCase();
        if (supported.includes(language)) return language;
        if (language.startsWith("pt")) return "pt-br";
        if (language.startsWith("zh")) return "zh-cn";
        const base = language.split("-")[0];
        return supported.includes(base) ? base : "en";
      }

      function readSavedLanguage() {
        try { return localStorage.getItem("evoprime-doc-lang"); }
        catch { return null; }
      }

      function saveLanguage(language) {
        try { localStorage.setItem("evoprime-doc-lang", language); }
        catch { /* CSS selection remains functional without storage. */ }
      }

      function applyLanguageMetadata(radio, persist = true) {
        if (!radio) return;
        document.documentElement.lang = radio.dataset.htmlLang || radio.value || "en";
        document.documentElement.dataset.activeLang = radio.value || "en";
        document.title = `${radio.dataset.docTitle || "EvoPrime 700 Documentation"} | GLightCore`;
        if (persist) saveLanguage(radio.value || "en");
      }

      radios.forEach((radio) => {
        radio.addEventListener("change", () => {
          if (radio.checked) applyLanguageMetadata(radio, true);
        });
      });

      const requested = new URLSearchParams(window.location.search).get("lang");
      const saved = readSavedLanguage();
      const browserLanguage = navigator.languages?.[0] || navigator.language || "en";
      const initialLanguage = normalizeLanguage(requested || saved || browserLanguage);
      const initialRadio = radios.find((radio) => radio.value === initialLanguage) || radios[0];

      if (initialRadio) {
        initialRadio.checked = true;
        applyLanguageMetadata(initialRadio, Boolean(requested || saved));
      }
    </script>
