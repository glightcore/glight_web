/* =================================================
   AUDIO ENGINE
================================================= */

let audioCtx = null;

function ensureAudio() {

  if (!audioCtx) {
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }

  if (audioCtx.state !== 'running') {
    audioCtx.resume();
  }

}


function playTone({

  freqStart,
  freqEnd = null,
  duration = 0.1,
  gain = 0.15,
  type = 'sine'

}) {

  ensureAudio();

  const osc = audioCtx.createOscillator();
  const g = audioCtx.createGain();

  osc.type = type;

  osc.frequency.setValueAtTime(freqStart, audioCtx.currentTime);

  if (freqEnd) {

    osc.frequency.exponentialRampToValueAtTime(
      freqEnd,
      audioCtx.currentTime + duration
    );

  }

  g.gain.setValueAtTime(0.0001, audioCtx.currentTime);

  g.gain.exponentialRampToValueAtTime(
    gain,
    audioCtx.currentTime + 0.01
  );

  g.gain.exponentialRampToValueAtTime(
    0.0001,
    audioCtx.currentTime + duration
  );

  osc.connect(g);
  g.connect(audioCtx.destination);

  osc.start();
  osc.stop(audioCtx.currentTime + duration + 0.02);

}

/* =================================================
   SONIDO REACTOR HOVER
   CAMPO BAJO SUAVE / ENERGÍA CONTENIDA
================================================= */

function soundReactorHover(){

  ensureAudio();

  const now = audioCtx.currentTime;

  const low = audioCtx.createOscillator();
  const body = audioCtx.createOscillator();

  const lowGain = audioCtx.createGain();
  const bodyGain = audioCtx.createGain();
  const masterGain = audioCtx.createGain();

  low.type = 'sine';
  body.type = 'triangle';

  // Campo bajo estable, no golpe
  low.frequency.setValueAtTime(72, now);
  low.frequency.linearRampToValueAtTime(82, now + 0.45);

  // Cuerpo suave, todavía grave
  body.frequency.setValueAtTime(118, now);
  body.frequency.linearRampToValueAtTime(104, now + 0.50);

  // Entrada suave + cola larga
  lowGain.gain.setValueAtTime(0.0001, now);
  lowGain.gain.linearRampToValueAtTime(0.038, now + 0.16);
  lowGain.gain.linearRampToValueAtTime(0.024, now + 0.55);
  lowGain.gain.linearRampToValueAtTime(0.0001, now + 1.55);

  bodyGain.gain.setValueAtTime(0.0001, now);
  bodyGain.gain.linearRampToValueAtTime(0.014, now + 0.18);
  bodyGain.gain.linearRampToValueAtTime(0.008, now + 0.52);
  bodyGain.gain.linearRampToValueAtTime(0.0001, now + 1.20);

  // Master más presente
  masterGain.gain.setValueAtTime(1.30, now);

  low.connect(lowGain);
  body.connect(bodyGain);

  lowGain.connect(masterGain);
  bodyGain.connect(masterGain);

  masterGain.connect(audioCtx.destination);

  low.start(now);
  body.start(now);

  low.stop(now + 1.40);
  body.stop(now + 1.25);
}

