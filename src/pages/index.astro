/* =================================================
   SONIDO NODE CLICK
   CHISPA / DESTELLO SHIIUII CON COLA
================================================= */

function soundClick() {

  ensureAudio();

  const now = audioCtx.currentTime;

  /* ruido blanco */
  const bufferSize = audioCtx.sampleRate * 0.85;
  const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
  const data = noiseBuffer.getChannelData(0);

  for (let i = 0; i < bufferSize; i++) {
    data[i] = (Math.random() * 2 - 1);
  }

  const noise = audioCtx.createBufferSource();
  noise.buffer = noiseBuffer;

  const filter = audioCtx.createBiquadFilter();
  const gain = audioCtx.createGain();
  const master = audioCtx.createGain();

  /* cola / energía residual */
  const delay = audioCtx.createDelay();
  const feedback = audioCtx.createGain();
  const delayFilter = audioCtx.createBiquadFilter();

  /* filtro de chispa: baja mientras se disuelve */
  filter.type = "bandpass";
  filter.frequency.setValueAtTime(2400, now);
  filter.frequency.exponentialRampToValueAtTime(900, now + 0.62);

  filter.Q.setValueAtTime(2.4, now);
  filter.Q.exponentialRampToValueAtTime(0.65, now + 0.62);

  /* ataque rápido + cola más larga */
  gain.gain.setValueAtTime(0.0001, now);
  gain.gain.exponentialRampToValueAtTime(0.055, now + 0.014);
  gain.gain.exponentialRampToValueAtTime(0.035, now + 0.12);
  gain.gain.exponentialRampToValueAtTime(0.012, now + 0.42);
  gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.82);

  master.gain.setValueAtTime(0.72, now);

  /* delay muy corto: no eco obvio, solo cola */
  delay.delayTime.setValueAtTime(0.055, now);
  feedback.gain.setValueAtTime(0.22, now);

  delayFilter.type = "lowpass";
  delayFilter.frequency.setValueAtTime(1800, now);

  noise.connect(filter);
  filter.connect(gain);

  /* ruta directa */
  gain.connect(master);

  /* ruta de cola */
  gain.connect(delay);
  delay.connect(delayFilter);
  delayFilter.connect(feedback);
  feedback.connect(delay);
  delay.connect(master);

  master.connect(audioCtx.destination);

  noise.start(now);
  noise.stop(now + 0.88);
}


/* =================================================
   CAMPO SONORO GLight
================================================= */

let fieldOsc = null;
let fieldGain = null;
let fieldInitialized = false;


window.addEventListener('pointerdown', () => {

  ensureAudio();
  initField();

}, { once: true });


function initField() {

  if (fieldInitialized) return;

  fieldOsc = audioCtx.createOscillator();
  fieldGain = audioCtx.createGain();

  fieldOsc.type = 'sine';

  fieldOsc.frequency.setValueAtTime(80, audioCtx.currentTime);
  fieldGain.gain.setValueAtTime(0.0001, audioCtx.currentTime);

  fieldOsc.connect(fieldGain);
  fieldGain.connect(audioCtx.destination);

  fieldOsc.start();

  fieldInitialized = true;

}


function enterField() {

  if (!fieldInitialized) return;

  const now = audioCtx.currentTime;

  fieldGain.gain.cancelScheduledValues(now);
  fieldOsc.frequency.cancelScheduledValues(now);

  fieldGain.gain.setValueAtTime(fieldGain.gain.value, now);
  fieldOsc.frequency.setValueAtTime(fieldOsc.frequency.value, now);

  fieldOsc.frequency.exponentialRampToValueAtTime(160, now + 0.18);
  fieldGain.gain.exponentialRampToValueAtTime(0.040, now + 0.18);

}


function leaveField() {

  if (!fieldInitialized) return;

  const now = audioCtx.currentTime;

  fieldGain.gain.cancelScheduledValues(now);
  fieldOsc.frequency.cancelScheduledValues(now);

  fieldGain.gain.setValueAtTime(fieldGain.gain.value, now);
  fieldOsc.frequency.setValueAtTime(fieldOsc.frequency.value, now);

  fieldOsc.frequency.exponentialRampToValueAtTime(70, now + 0.75);
  fieldGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.9);

}


